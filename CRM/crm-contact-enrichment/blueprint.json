{
  "name": "CRM Contact Enrichment (scheduled write-back)",
  "flow": [
    {
      "id": 1,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
      "mapper": {
        "url": "https://YOUR_CRM_API/v1/contacts/search",
        "method": "post",
        "headers": [
          { "name": "Authorization", "value": "Bearer {{connection.apiKey}}" },
          { "name": "Content-Type", "value": "application/json" }
        ],
        "qs": [],
        "bodyType": "raw",
        "parseResponse": true,
        "contentType": "application/json",
        "data": "{\n  \"filter\": { \"enriched\": false, \"email\": { \"isNotEmpty\": true } },\n  \"limit\": 50\n}"
      },
      "metadata": {
        "designer": { "x": 0, "y": 0 },
        "restore": { "parameters": { "url": { "label": "Search un-enriched contacts" } } }
      },
      "onerror": [
        {
          "id": 11,
          "module": "builtin:Break",
          "version": 1,
          "parameters": {},
          "mapper": { "count": "3", "interval": "5", "retry": true },
          "metadata": { "designer": { "x": 0, "y": 300 } }
        }
      ]
    },
    {
      "id": 2,
      "module": "builtin:BasicFeeder",
      "version": 1,
      "parameters": {},
      "mapper": { "array": "{{1.data.results}}" },
      "metadata": {
        "designer": { "x": 300, "y": 0 },
        "restore": { "parameters": { "array": { "label": "Iterate contacts" } } }
      }
    },
    {
      "id": 3,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
      "mapper": {
        "url": "https://YOUR_ENRICHMENT_API/v1/enrich",
        "method": "get",
        "headers": [
          { "name": "Authorization", "value": "Bearer {{connection.enrichKey}}" }
        ],
        "qs": [
          { "name": "email", "value": "{{2.email}}" },
          { "name": "domain", "value": "{{2.company_domain}}" }
        ],
        "parseResponse": true
      },
      "metadata": {
        "designer": { "x": 600, "y": 0 },
        "restore": { "parameters": { "url": { "label": "Enrich (provider lookup)" } } }
      },
      "onerror": [
        {
          "id": 31,
          "module": "datastore:AddReplaceRecord",
          "version": 1,
          "parameters": { "datastore": "1" },
          "mapper": {
            "key": "enrich-err-{{2.id}}-{{now}}",
            "overwrite": false,
            "record": {
              "timestamp": "{{now}}",
              "scenario": "crm-contact-enrichment",
              "status": "error",
              "record_id": "{{2.email}}",
              "message": "Enrichment lookup failed for {{2.email}}"
            }
          },
          "metadata": { "designer": { "x": 600, "y": 300 } },
          "onerror": [
            {
              "id": 32,
              "module": "builtin:Resume",
              "version": 1,
              "parameters": {},
              "mapper": { "value": "logged" },
              "metadata": { "designer": { "x": 600, "y": 600 } }
            }
          ]
        }
      ]
    },
    {
      "id": 4,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
      "mapper": {
        "url": "https://YOUR_CRM_API/v1/contacts/{{2.id}}",
        "method": "patch",
        "headers": [
          { "name": "Authorization", "value": "Bearer {{connection.apiKey}}" },
          { "name": "Content-Type", "value": "application/json" }
        ],
        "qs": [],
        "bodyType": "raw",
        "parseResponse": true,
        "contentType": "application/json",
        "data": "{\n  \"jobTitle\": \"{{3.data.title}}\",\n  \"seniority\": \"{{3.data.seniority}}\",\n  \"companySize\": \"{{3.data.company.size}}\",\n  \"industry\": \"{{3.data.company.industry}}\",\n  \"linkedin\": \"{{3.data.linkedin}}\",\n  \"enriched\": true\n}"
      },
      "metadata": {
        "designer": { "x": 900, "y": 0 },
        "restore": { "parameters": { "url": { "label": "Write enrichment back" } } }
      },
      "onerror": [
        {
          "id": 41,
          "module": "builtin:Break",
          "version": 1,
          "parameters": {},
          "mapper": { "count": "3", "interval": "10", "retry": true },
          "metadata": { "designer": { "x": 900, "y": 300 } }
        }
      ]
    },
    {
      "id": 5,
      "module": "datastore:AddReplaceRecord",
      "version": 1,
      "parameters": { "datastore": "1" },
      "mapper": {
        "key": "enrich-ok-{{2.id}}-{{now}}",
        "overwrite": false,
        "record": {
          "timestamp": "{{now}}",
          "scenario": "crm-contact-enrichment",
          "status": "success",
          "record_id": "{{2.email}}",
          "message": "Enriched: {{3.data.title}} @ {{3.data.company.industry}}"
        }
      },
      "metadata": { "designer": { "x": 1200, "y": 0 } }
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "slots": null,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": { "orphans": [] },
    "zone": "us1.make.com",
    "notes": []
  }
}
