{
  "name": "Overdue Invoice Dunning (staged)",
  "flow": [
    {
      "id": 1,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
      "mapper": {
        "url": "https://YOUR_BILLING_API/v1/invoices/search",
        "method": "post",
        "headers": [
          { "name": "Authorization", "value": "Bearer YOUR_BILLING_API_KEY" },
          { "name": "Content-Type", "value": "application/json" }
        ],
        "qs": [],
        "bodyType": "raw",
        "parseResponse": true,
        "contentType": "application/json",
        "data": "{\n  \"filter\": { \"status\": \"open\", \"dueBefore\": \"{{now}}\" },\n  \"limit\": 200\n}"
      },
      "metadata": {
        "designer": { "x": 0, "y": 0 },
        "restore": { "parameters": { "url": { "label": "Find open overdue invoices" } } }
      },
      "onerror": [
        { "id": 11, "module": "builtin:Break", "version": 1, "parameters": {}, "mapper": { "count": "3", "interval": "5", "retry": true }, "metadata": { "designer": { "x": 0, "y": 300 } } }
      ]
    },
    {
      "id": 2,
      "module": "builtin:BasicFeeder",
      "version": 1,
      "parameters": {},
      "mapper": { "array": "{{1.data.results}}" },
      "metadata": {
        "designer": { "x": 300, "y": 0 },
        "restore": { "parameters": { "array": { "label": "Iterate invoices" } } }
      }
    },
    {
      "id": 3,
      "module": "builtin:BasicRouter",
      "version": 1,
      "mapper": null,
      "metadata": { "designer": { "x": 600, "y": 0 } },
      "routes": [
        {
          "flow": [
            {
              "id": 4,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
              "filter": {
                "name": "7–13 days overdue",
                "conditions": [
                  [
                    { "a": "{{floor(dateDifference(now; 2.dueDate; \"days\"))}}", "o": "greater:equal", "b": "7" },
                    { "a": "{{floor(dateDifference(now; 2.dueDate; \"days\"))}}", "o": "less", "b": "14" }
                  ]
                ]
              },
              "mapper": {
                "url": "https://api.resend.com/emails",
                "method": "post",
                "headers": [
                  { "name": "Authorization", "value": "Bearer YOUR_EMAIL_API_KEY" },
                  { "name": "Content-Type", "value": "application/json" }
                ],
                "qs": [],
                "bodyType": "raw",
                "parseResponse": true,
                "contentType": "application/json",
                "data": "{\n  \"from\": \"Billing <billing@yourdomain.com>\",\n  \"to\": [\"{{2.customer.email}}\"],\n  \"subject\": \"Friendly reminder: invoice {{2.number}}\",\n  \"html\": \"<p>Hi {{2.customer.firstName}},</p><p>Just a gentle nudge that invoice <strong>{{2.number}}</strong> for {{formatNumber(2.amount; 2)}} {{2.currency}} was due on {{formatDate(2.dueDate; \\\"MMM D\\\")}}. You can pay here: {{2.payUrl}}.</p><p>Thanks!</p>\"\n}"
              },
              "metadata": { "designer": { "x": 900, "y": -150 }, "restore": { "parameters": { "url": { "label": "Stage 1: gentle reminder email" } } } },
              "onerror": [
                { "id": 41, "module": "builtin:Break", "version": 1, "parameters": {}, "mapper": { "count": "3", "interval": "10", "retry": true }, "metadata": { "designer": { "x": 900, "y": 100 } } }
              ]
            },
            {
              "id": 5,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
              "mapper": {
                "url": "https://YOUR_LOG_SINK/append",
                "method": "post",
                "headers": [ { "name": "Content-Type", "value": "application/json" } ],
                "qs": [],
                "bodyType": "raw",
                "parseResponse": false,
                "contentType": "application/json",
                "data": "{\n  \"timestamp\": \"{{now}}\",\n  \"scenario\": \"overdue-invoice-dunning\",\n  \"status\": \"success\",\n  \"record_id\": \"{{2.number}}\",\n  \"message\": \"Stage 1 (gentle) reminder sent to {{2.customer.email}}\"\n}"
              },
              "metadata": { "designer": { "x": 1200, "y": -150 } },
              "onerror": [
                { "id": 51, "module": "builtin:Resume", "version": 1, "parameters": {}, "mapper": { "value": "logged" }, "metadata": { "designer": { "x": 1200, "y": 100 } } }
              ]
            }
          ]
        },
        {
          "flow": [
            {
              "id": 6,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
              "filter": {
                "name": "14–29 days overdue",
                "conditions": [
                  [
                    { "a": "{{floor(dateDifference(now; 2.dueDate; \"days\"))}}", "o": "greater:equal", "b": "14" },
                    { "a": "{{floor(dateDifference(now; 2.dueDate; \"days\"))}}", "o": "less", "b": "30" }
                  ]
                ]
              },
              "mapper": {
                "url": "https://api.resend.com/emails",
                "method": "post",
                "headers": [
                  { "name": "Authorization", "value": "Bearer YOUR_EMAIL_API_KEY" },
                  { "name": "Content-Type", "value": "application/json" }
                ],
                "qs": [],
                "bodyType": "raw",
                "parseResponse": true,
                "contentType": "application/json",
                "data": "{\n  \"from\": \"Billing <billing@yourdomain.com>\",\n  \"to\": [\"{{2.customer.email}}\"],\n  \"subject\": \"Action needed: invoice {{2.number}} is now {{floor(dateDifference(now; 2.dueDate; \\\"days\\\"))}} days overdue\",\n  \"html\": \"<p>Hi {{2.customer.firstName}},</p><p>Invoice <strong>{{2.number}}</strong> ({{formatNumber(2.amount; 2)}} {{2.currency}}) remains unpaid and is now {{floor(dateDifference(now; 2.dueDate; \\\"days\\\"))}} days past due. Please settle it within 5 business days to avoid a late fee: {{2.payUrl}}.</p>\"\n}"
              },
              "metadata": { "designer": { "x": 900, "y": 0 }, "restore": { "parameters": { "url": { "label": "Stage 2: firm reminder email" } } } },
              "onerror": [
                { "id": 61, "module": "builtin:Break", "version": 1, "parameters": {}, "mapper": { "count": "3", "interval": "10", "retry": true }, "metadata": { "designer": { "x": 900, "y": 250 } } }
              ]
            },
            {
              "id": 7,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
              "mapper": {
                "url": "https://YOUR_LOG_SINK/append",
                "method": "post",
                "headers": [ { "name": "Content-Type", "value": "application/json" } ],
                "qs": [],
                "bodyType": "raw",
                "parseResponse": false,
                "contentType": "application/json",
                "data": "{\n  \"timestamp\": \"{{now}}\",\n  \"scenario\": \"overdue-invoice-dunning\",\n  \"status\": \"success\",\n  \"record_id\": \"{{2.number}}\",\n  \"message\": \"Stage 2 (firm) reminder sent to {{2.customer.email}}\"\n}"
              },
              "metadata": { "designer": { "x": 1200, "y": 0 } },
              "onerror": [
                { "id": 71, "module": "builtin:Resume", "version": 1, "parameters": {}, "mapper": { "value": "logged" }, "metadata": { "designer": { "x": 1200, "y": 250 } } }
              ]
            }
          ]
        },
        {
          "flow": [
            {
              "id": 8,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
              "filter": {
                "name": "30+ days overdue",
                "conditions": [
                  [ { "a": "{{floor(dateDifference(now; 2.dueDate; \"days\"))}}", "o": "greater:equal", "b": "30" } ]
                ]
              },
              "mapper": {
                "url": "https://hooks.slack.com/services/REPLACE_WITH_YOUR_SLACK_WEBHOOK",
                "method": "post",
                "headers": [ { "name": "Content-Type", "value": "application/json" } ],
                "qs": [],
                "bodyType": "raw",
                "parseResponse": false,
                "contentType": "application/json",
                "data": "{\n  \"text\": \":warning: *Invoice escalation* — {{2.number}} is {{floor(dateDifference(now; 2.dueDate; \\\"days\\\"))}} days overdue\\nCustomer: {{2.customer.name}} ({{2.customer.email}})\\nAmount: {{formatNumber(2.amount; 2)}} {{2.currency}}\\nAutomated reminders exhausted — a human should call.\"\n}"
              },
              "metadata": { "designer": { "x": 900, "y": 200 }, "restore": { "parameters": { "url": { "label": "Stage 3: Slack escalation (#finance)" } } } },
              "onerror": [
                { "id": 81, "module": "builtin:Break", "version": 1, "parameters": {}, "mapper": { "count": "3", "interval": "5", "retry": true }, "metadata": { "designer": { "x": 900, "y": 450 } } }
              ]
            },
            {
              "id": 9,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
              "mapper": {
                "url": "https://YOUR_LOG_SINK/append",
                "method": "post",
                "headers": [ { "name": "Content-Type", "value": "application/json" } ],
                "qs": [],
                "bodyType": "raw",
                "parseResponse": false,
                "contentType": "application/json",
                "data": "{\n  \"timestamp\": \"{{now}}\",\n  \"scenario\": \"overdue-invoice-dunning\",\n  \"status\": \"escalated\",\n  \"record_id\": \"{{2.number}}\",\n  \"message\": \"Escalated to finance team (30+ days)\"\n}"
              },
              "metadata": { "designer": { "x": 1200, "y": 200 } },
              "onerror": [
                { "id": 91, "module": "builtin:Resume", "version": 1, "parameters": {}, "mapper": { "value": "logged" }, "metadata": { "designer": { "x": 1200, "y": 450 } } }
              ]
            }
          ]
        }
      ]
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "slots": null,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": { "orphans": [] },
    "zone": "us1.make.com",
    "notes": []
  }
}
