{
  "name": "AI Content Repurposer",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": { "hook": 0, "maxResults": 1 },
      "mapper": {},
      "metadata": {
        "designer": { "x": 0, "y": 0 },
        "restore": { "parameters": { "hook": { "label": "New Content Published Webhook" } } }
      }
    },
    {
      "id": 2,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
      "mapper": {
        "url": "https://api.openai.com/v1/chat/completions",
        "method": "post",
        "headers": [
          { "name": "Authorization", "value": "Bearer YOUR_OPENAI_API_KEY" },
          { "name": "Content-Type", "value": "application/json" }
        ],
        "qs": [],
        "bodyType": "raw",
        "parseResponse": true,
        "contentType": "application/json",
        "data": "{\n  \"model\": \"gpt-4o\",\n  \"temperature\": 0.7,\n  \"response_format\": { \"type\": \"json_object\" },\n  \"messages\": [\n    { \"role\": \"system\", \"content\": \"You repurpose one long-form article into channel-native short content. Respond ONLY with minified JSON. Schema: {\\\"linkedin\\\":\\\"<=1300 chars, hook-first, one idea, no hashtag spam\\\",\\\"twitter_thread\\\":[\\\"tweet 1 hook\\\",\\\"...\\\",\\\"final CTA\\\"],\\\"newsletter_blurb\\\":\\\"<=80 words\\\",\\\"meta_description\\\":\\\"<=155 chars\\\"}. Keep the author's voice. Never invent facts not in the source.\" },\n    { \"role\": \"user\", \"content\": \"Title: {{1.title}}\\nURL: {{1.url}}\\n\\nArticle:\\n{{1.content}}\" }\n  ]\n}"
      },
      "metadata": {
        "designer": { "x": 300, "y": 0 },
        "restore": { "parameters": { "url": { "label": "LLM repurpose (OpenAI chat completions)" } } }
      },
      "onerror": [
        { "id": 21, "module": "builtin:Break", "version": 1, "parameters": {}, "mapper": { "count": "3", "interval": "3", "retry": true }, "metadata": { "designer": { "x": 300, "y": 300 } } }
      ]
    },
    {
      "id": 3,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
      "mapper": {
        "url": "https://hooks.slack.com/services/REPLACE_WITH_YOUR_SLACK_WEBHOOK",
        "method": "post",
        "headers": [ { "name": "Content-Type", "value": "application/json" } ],
        "qs": [],
        "bodyType": "raw",
        "parseResponse": false,
        "contentType": "application/json",
        "data": "{\n  \"text\": \":memo: *Drafts ready for review* — {{1.title}}\\n{{1.url}}\\n\\n*LinkedIn*\\n{{parseJSON(2.data.choices[1].message.content).linkedin}}\\n\\n*Newsletter*\\n{{parseJSON(2.data.choices[1].message.content).newsletter_blurb}}\\n\\n*Thread* ({{length(parseJSON(2.data.choices[1].message.content).twitter_thread)}} tweets)\\n{{join(parseJSON(2.data.choices[1].message.content).twitter_thread; \\\"\\n— \\\")}}\\n\\nEdit & schedule, or react :x: to discard.\"\n}"
      },
      "metadata": {
        "designer": { "x": 600, "y": 0 },
        "restore": { "parameters": { "url": { "label": "Slack incoming webhook (#content-review)" } } }
      },
      "onerror": [
        { "id": 31, "module": "builtin:Break", "version": 1, "parameters": {}, "mapper": { "count": "2", "interval": "3", "retry": true }, "metadata": { "designer": { "x": 600, "y": 300 } } }
      ]
    },
    {
      "id": 4,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
      "mapper": {
        "url": "https://YOUR_LOG_SINK/append",
        "method": "post",
        "headers": [ { "name": "Content-Type", "value": "application/json" } ],
        "qs": [],
        "bodyType": "raw",
        "parseResponse": false,
        "contentType": "application/json",
        "data": "{\n  \"timestamp\": \"{{now}}\",\n  \"scenario\": \"ai-content-repurposer\",\n  \"status\": \"success\",\n  \"record_id\": \"{{1.url}}\",\n  \"message\": \"Generated LinkedIn + {{length(parseJSON(2.data.choices[1].message.content).twitter_thread)}}-tweet thread + newsletter blurb\"\n}"
      },
      "metadata": { "designer": { "x": 900, "y": 0 } },
      "onerror": [
        { "id": 41, "module": "builtin:Resume", "version": 1, "parameters": {}, "mapper": { "value": "logged" }, "metadata": { "designer": { "x": 900, "y": 300 } } }
      ]
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "slots": null,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": { "orphans": [] },
    "zone": "us1.make.com",
    "notes": []
  }
}
