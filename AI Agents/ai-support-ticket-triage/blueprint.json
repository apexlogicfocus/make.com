{
  "name": "AI Support Ticket Triage",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": { "hook": 0, "maxResults": 1 },
      "mapper": {},
      "metadata": {
        "designer": { "x": 0, "y": 0 },
        "restore": { "parameters": { "hook": { "label": "New Support Ticket Webhook" } } }
      }
    },
    {
      "id": 2,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
      "mapper": {
        "url": "https://api.openai.com/v1/chat/completions",
        "method": "post",
        "headers": [
          { "name": "Authorization", "value": "Bearer YOUR_OPENAI_API_KEY" },
          { "name": "Content-Type", "value": "application/json" }
        ],
        "qs": [],
        "bodyType": "raw",
        "parseResponse": true,
        "contentType": "application/json",
        "data": "{\n  \"model\": \"gpt-4o-mini\",\n  \"temperature\": 0,\n  \"response_format\": { \"type\": \"json_object\" },\n  \"messages\": [\n    { \"role\": \"system\", \"content\": \"You are a support triage assistant. Respond ONLY with minified JSON, no prose. Schema: {\\\"category\\\":\\\"billing|technical|account|feature_request|other\\\",\\\"priority\\\":\\\"urgent|high|normal|low\\\",\\\"sentiment\\\":\\\"angry|frustrated|neutral|happy\\\",\\\"suggested_team\\\":\\\"string\\\",\\\"summary\\\":\\\"one sentence\\\"}. Mark priority urgent only for outages, security, data loss, or churn-risk language.\" },\n    { \"role\": \"user\", \"content\": \"Subject: {{1.subject}}\\nPlan: {{1.plan}}\\nBody:\\n{{1.body}}\" }\n  ]\n}"
      },
      "metadata": {
        "designer": { "x": 300, "y": 0 },
        "restore": { "parameters": { "url": { "label": "LLM classify (OpenAI chat completions)" } } }
      },
      "onerror": [
        { "id": 21, "module": "builtin:Break", "version": 1, "parameters": {}, "mapper": { "count": "3", "interval": "3", "retry": true }, "metadata": { "designer": { "x": 300, "y": 300 } } }
      ]
    },
    {
      "id": 3,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
      "mapper": {
        "url": "https://YOUR_HELPDESK_API/v1/tickets/{{1.ticketId}}",
        "method": "patch",
        "headers": [
          { "name": "Authorization", "value": "Bearer YOUR_HELPDESK_API_KEY" },
          { "name": "Content-Type", "value": "application/json" }
        ],
        "qs": [],
        "bodyType": "raw",
        "parseResponse": true,
        "contentType": "application/json",
        "data": "{\n  \"priority\": \"{{parseJSON(2.data.choices[1].message.content).priority}}\",\n  \"tags\": [\"{{parseJSON(2.data.choices[1].message.content).category}}\", \"sentiment:{{parseJSON(2.data.choices[1].message.content).sentiment}}\"],\n  \"assigned_team\": \"{{parseJSON(2.data.choices[1].message.content).suggested_team}}\",\n  \"internal_note\": \"AI summary: {{parseJSON(2.data.choices[1].message.content).summary}}\"\n}"
      },
      "metadata": {
        "designer": { "x": 600, "y": 0 },
        "restore": { "parameters": { "url": { "label": "Update ticket with triage" } } }
      },
      "onerror": [
        { "id": 31, "module": "builtin:Break", "version": 1, "parameters": {}, "mapper": { "count": "3", "interval": "5", "retry": true }, "metadata": { "designer": { "x": 600, "y": 300 } } }
      ]
    },
    {
      "id": 4,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
      "filter": {
        "name": "Urgent only",
        "conditions": [
          [ { "a": "{{parseJSON(2.data.choices[1].message.content).priority}}", "o": "text:equal", "b": "urgent" } ]
        ]
      },
      "mapper": {
        "url": "https://hooks.slack.com/services/REPLACE_WITH_YOUR_SLACK_WEBHOOK",
        "method": "post",
        "headers": [ { "name": "Content-Type", "value": "application/json" } ],
        "qs": [],
        "bodyType": "raw",
        "parseResponse": false,
        "contentType": "application/json",
        "data": "{\n  \"text\": \":rotating_light: *URGENT ticket* #{{1.ticketId}}\\n*{{1.subject}}*\\nCategory: {{parseJSON(2.data.choices[1].message.content).category}} · Sentiment: {{parseJSON(2.data.choices[1].message.content).sentiment}}\\n{{parseJSON(2.data.choices[1].message.content).summary}}\\nRouted to: {{parseJSON(2.data.choices[1].message.content).suggested_team}}\"\n}"
      },
      "metadata": {
        "designer": { "x": 900, "y": 0 },
        "restore": { "parameters": { "url": { "label": "Slack incoming webhook (#support-oncall)" } } }
      },
      "onerror": [
        { "id": 41, "module": "builtin:Resume", "version": 1, "parameters": {}, "mapper": { "value": "notify-skipped" }, "metadata": { "designer": { "x": 900, "y": 300 } } }
      ]
    },
    {
      "id": 5,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
      "mapper": {
        "url": "https://YOUR_LOG_SINK/append",
        "method": "post",
        "headers": [ { "name": "Content-Type", "value": "application/json" } ],
        "qs": [],
        "bodyType": "raw",
        "parseResponse": false,
        "contentType": "application/json",
        "data": "{\n  \"timestamp\": \"{{now}}\",\n  \"scenario\": \"ai-support-ticket-triage\",\n  \"status\": \"success\",\n  \"record_id\": \"{{1.ticketId}}\",\n  \"message\": \"{{parseJSON(2.data.choices[1].message.content).priority}} / {{parseJSON(2.data.choices[1].message.content).category}} → {{parseJSON(2.data.choices[1].message.content).suggested_team}}\"\n}"
      },
      "metadata": { "designer": { "x": 1200, "y": 0 } },
      "onerror": [
        { "id": 51, "module": "builtin:Resume", "version": 1, "parameters": {}, "mapper": { "value": "logged" }, "metadata": { "designer": { "x": 1200, "y": 300 } } }
      ]
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "slots": null,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": { "orphans": [] },
    "zone": "us1.make.com",
    "notes": []
  }
}
