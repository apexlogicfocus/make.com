{
  "name": "Daily Ops Digest",
  "flow": [
    {
      "id": 1,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
      "mapper": {
        "url": "https://YOUR_LOG_SINK/summary",
        "method": "get",
        "headers": [ { "name": "Content-Type", "value": "application/json" } ],
        "qs": [
          { "name": "since", "value": "{{addDays(now; -1)}}" }
        ],
        "parseResponse": true
      },
      "metadata": {
        "designer": { "x": 0, "y": 0 },
        "restore": { "parameters": { "url": { "label": "Query Automation Log summary (last 24h)" } } }
      },
      "onerror": [
        { "id": 11, "module": "builtin:Break", "version": 1, "parameters": {}, "mapper": { "count": "2", "interval": "3", "retry": true }, "metadata": { "designer": { "x": 0, "y": 300 } } }
      ]
    },
    {
      "id": 2,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
      "mapper": {
        "url": "https://hooks.slack.com/services/REPLACE_WITH_YOUR_SLACK_WEBHOOK",
        "method": "post",
        "headers": [ { "name": "Content-Type", "value": "application/json" } ],
        "qs": [],
        "bodyType": "raw",
        "parseResponse": false,
        "contentType": "application/json",
        "data": "{\n  \"text\": \":bar_chart: *Daily Ops Digest* — {{formatDate(now; \\\"ddd, MMM D\\\")}}\\n:white_check_mark: Successful runs (24h): *{{1.data.success}}*\\n:x: Errors (24h): *{{1.data.error}}*\\n:warning: Escalations (24h): *{{1.data.escalated}}*\\n{{if(1.data.error > 0; \\\"Check the Automation Log for error rows.\\\"; \\\"All systems healthy.\\\")}}\"\n}"
      },
      "metadata": {
        "designer": { "x": 300, "y": 0 },
        "restore": { "parameters": { "url": { "label": "Slack incoming webhook (#ops)" } } }
      },
      "onerror": [
        { "id": 21, "module": "builtin:Break", "version": 1, "parameters": {}, "mapper": { "count": "3", "interval": "5", "retry": true }, "metadata": { "designer": { "x": 300, "y": 300 } } }
      ]
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "slots": null,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": { "orphans": [] },
    "zone": "us1.make.com",
    "notes": []
  }
}
