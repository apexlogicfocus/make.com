{
    "name": "SEO and Keyword Optimization Agent",
    "flow": [
        {
            "id": 10,
            "module": "gateway:CustomWebHook",
            "version": 1,
            "metadata": {
                "designer": {
                    "x": -9,
                    "y": -19,
                    "messages": [
                        {
                            "category": "setup",
                            "severity": "error",
                            "message": "Webhook: Value must not be empty."
                        }
                    ]
                }
