                                    "51593452-3ce8-4969-b28d-adef189f32b1",
                                    "7f59aa27-273f-4320-b977-2d3f5995feb2",
                                    "cc284f6b-00c9-4ce2-b91e-8fd98a6432d1"
                                ]
                            },
                            "metadata": {
                                "designer": {
                                    "x": 600,
                                    "y": 250
                                },
                                "restore": {},
                                "expect": [
                                    {
                                        "name": "filestorage",
                                        "type": "filestorage",
                                        "label": "Knowledge files"
                                    },
                                    {
                                        "name": "query",
                                        "type": "text",
                                        "label": "Search query",
                                        "required": true
                                    },
                                    {
                                        "name": "fileIds",
                                        "type": "hidden",
                                        "required": true
                                    },
                                    {
                                        "name": "limit",
                                        "type": "number",
                                        "label": "Limit",
                                        "required": true,
                                        "validate": {
                                            "max": 500,
                                            "min": 1
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            ]
