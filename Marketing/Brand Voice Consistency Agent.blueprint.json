        {
            "id": 24,
            "module": "ai-local-agent:RunLocalAIAgent",
            "version": 0,
            "parameters": {
                "makeConnectionId": null
            },
            "filter": {
                "name": "",
                "conditions": [
                    [
                        {
                            "a": "{{21.type}}",
                            "b": "message",
                            "o": "text:equal:ci"
                        },
                        {
                            "a": "{{21.bot_id}}",
                            "o": "notexist"
                        },
                        {
                            "a": "{{21.text}}",
                            "o": "exist"
                        }
                    ],
                    [
                        {
                            "a": "{{21.thread_ts}}",
                            "o": "exist"
                        },
                        {
                            "a": "{{21.text}}",
                            "o": "exist"
                        }
                    ]
                ]
            },
            "mapper": {
                "files": [],
                "message": "{{21.text}}",
                "timeout": "",
                "threadId": "{{ifempty(21.thread_ts; 21.ts)}}",
                "outputType": "text",
                "modelConfig": {
                    "recursionLimit": "2",
                    "iterationsFromHistoryCount": "10"
                },
                "defaultModel": "gpt-5.2",
                "systemPrompt": "# ROLE\nYou are the {company} UX Writing Advisor. Your role is to provide expert guidance on UI copy, tooltips, and helper text for the {company} platform, ensuring all suggestions are professional, concise, and helpful.\n\n# KNOWLEDGE BASE & TONE\n* Strictly adhere to the 'UX Writing Best Practices' and 'UX Writing Examples' files.\n* Always use the '{company} Company Terminology' file to ensure naming consistency.\n* Tone: Professional, expert, and helpful. \n* Restriction: Avoid \"cutesy\" or alarmist language (e.g., no \"oops,\" \"uh-oh,\" or \"whoops\").\n\n# TASK EXECUTION\nWhen a Slack message is received:\n1. Analyze the user's specific UX writing dilemma.\n2. Cross-reference the request with the provided Knowledge Base files.\n3. Provide a \"Current vs. Improved\" comparison if applicable.\n4. Briefly explain the \"Why\" behind your suggestion based on UX principles (e.g., scannability, clarity, or action-oriented language).\n\n# SLACK FORMATTING RULES (MANDATORY)\n* No Markdown headers: Do not use #, ##, or ###.\n* Bolding: Use single asterisks *like this*.\n* Spacing: Use a single line break between related items and a double line break only between distinct sections.\n* Visuals: Use relevant emojis (e.g., 💡, ✅, ⚠️) to improve scannability.\n* Hierarchy: Bold the category name or the value, but avoid bolding the entire line."
            },
            "metadata": {
                "designer": {
                    "x": 300,
                    "y": 0,
                    "name": "UX writing agent",
                    "messages": [
                        {
                            "category": "setupreq",
                            "severity": "error",
                            "message": "The module is not set up."
                        }
                    ]
                },
                "restore": {
                    "expect": {
                        "files": {
                            "mode": "chose"
                        },
                        "outputType": {
                            "label": "Text"
                        },
                        "defaultModel": {
                            "mode": "chose",
                            "label": "GPT-5.2The most advanced model with superior reasoning, speed, and instruction-following for complex, real-world tasks",
                            "nested": []
                        }
                    },
                    "parameters": {
                        "makeConnectionId": {
                            "data": {
                                "scoped": "true",
                                "connection": "ai-provider"
                            },
                            "label": "My OpenAI connection"
                        }
                    }
                },
                "parameters": [
                    {
                        "name": "makeConnectionId",
                        "type": "account:ai-provider,openai-gpt-3,anthropic-claude,gemini-ai-q9zyjp,ai-agent-foundry-openai,ai-agent-foundry-non-openai,mistral-ai,cohere,groq,ai-agent-xai,amazon-bedrock,ai-agent-openai-compatible",
                        "label": "Connection",
                        "required": true
                    }
                ],
                "expect": [
                    {
                        "name": "defaultModel",
                        "type": "select",
                        "label": "Model",
                        "required": true
                    },
                    {
                        "name": "systemPrompt",
                        "type": "text",
                        "label": "Instructions"
                    },
                    {
                        "name": "message",
                        "type": "text",
                        "label": "Input",
                        "required": true
                    },
                    {
                        "name": "files",
                        "spec": [
                            {
                                "name": "fileName",
                                "type": "filename",
                                "label": "File name",
                                "semantic": "file:name"
                            },
                            {
                                "name": "data",
                                "type": "buffer",
                                "label": "Data",
                                "semantic": "file:data"
                            }
                        ],
                        "type": "array",
                        "label": "Input files"
                    },
                    {
                        "name": "threadId",
                        "type": "text",
                        "label": "Conversation ID"
                    },
                    {
                        "name": "modelConfig",
                        "spec": [
                            {
                                "name": "tokenLimit",
                                "type": "hidden",
                                "label": "Max output tokens"
                            },
                            {
                                "name": "recursionLimit",
                                "type": "hidden",
                                "label": "Steps per agent call"
                            },
                            {
                                "name": "iterationsFromHistoryCount",
                                "type": "number",
                                "label": "Maximum conversation history"
                            }
                        ],
                        "type": "collection",
                        "label": "Model configuration"
                    },
                    {
                        "name": "timeout",
                        "type": "number",
                        "label": "Step timeout",
                        "validate": {
                            "max": 600,
                            "min": 120
                        }
                    },
                    {
                        "name": "outputType",
                        "type": "select",
                        "label": "Response format",
                        "required": true,
                        "validate": {
                            "enum": [
                                "text",
                                "make-schema"
                            ]
                        }
                    }
                ],
                "advanced": true
            },
            "tools": [
